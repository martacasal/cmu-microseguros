# Configurações de LLM para o Chat Interativo do Pulso
# Pode usar Gemini, OpenAI, Claude, ou deixar em branco para usar o MODO MOCK AUTOMÁTICO (simulação rica offline)

# Opção 1: Google Gemini (Recomendado)
GEMINI_API_KEY=

# Opção 2: OpenAI (ex: gpt-4o, gpt-4o-mini)
OPENAI_API_KEY=

# Opção 3: Anthropic Claude (ex: claude-3-5-sonnet)
ANTHROPIC_API_KEY=

# Modo predefinido (mock, gemini, openai, anthropic)
# Se nenhuma chave for fornecida, o sistema usa automaticamente 'mock' sem erros!
LLM_PROVIDER=mock
