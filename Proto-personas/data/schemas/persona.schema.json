{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NNgPersonaSchema",
  "description": "Schema para Personas do projeto Pulso segundo normas da Nielsen Norman Group (NN/g)",
  "type": "object",
  "required": [
    "id",
    "name",
    "archetype",
    "type",
    "age",
    "location",
    "occupation",
    "quote",
    "bio",
    "demographics",
    "consumptionHabits",
    "activities",
    "insuranceAttitude",
    "painPoints",
    "goalsAndMotivations",
    "pulsoFit",
    "researchFoundation"
  ],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "archetype": { "type": "string" },
    "type": { "type": "string", "enum": ["target", "secondary", "anti-persona"] },
    "age": { "type": "integer" },
    "location": { "type": "string" },
    "occupation": { "type": "string" },
    "avatar": { "type": "string" },
    "quote": { "type": "string" },
    "bio": { "type": "string" },
    "demographics": {
      "type": "object",
      "properties": {
        "education": { "type": "string" },
        "incomeLevel": { "type": "string" },
        "familyStatus": { "type": "string" },
        "techComfort": { "type": "string", "enum": ["Muito Alta", "Alta", "Média", "Baixa"] },
        "primaryDevices": { "type": "array", "items": { "type": "string" } }
      }
    },
    "consumptionHabits": {
      "type": "object",
      "properties": {
        "decisionTrigger": { "type": "string" },
        "decisionLeadTime": { "type": "string" },
        "preferredPaymentMethods": { "type": "array", "items": { "type": "string" } },
        "spendingAttitude": { "type": "string" },
        "digitalServicesUsed": { "type": "array", "items": { "type": "string" } }
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "frequency": { "type": "string" },
          "environment": { "type": "string" },
          "riskLevel": { "type": "integer", "minimum": 1, "maximum": 4 },
          "commonInjuries": { "type": "string" }
        }
      }
    },
    "insuranceAttitude": {
      "type": "object",
      "properties": {
        "currentProtection": { "type": "string" },
        "misconceptions": { "type": "string" },
        "perceivedRisk": { "type": "string" },
        "barrierToTraditionalInsurance": { "type": "string" }
      }
    },
    "painPoints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "goalsAndMotivations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pulsoFit": {
      "type": "object",
      "properties": {
        "fitScore": { "type": "string", "enum": ["Alto", "Médio-Alto", "Incompatível (Anti-Persona)"] },
        "whyTheyBuyOrReject": { "type": "string" },
        "keyFeaturesNeeded": { "type": "array", "items": { "type": "string" } },
        "rejectionRisk": { "type": "string" }
      }
    },
    "researchFoundation": {
      "type": "object",
      "properties": {
        "groundedFacts": { "type": "array", "items": { "type": "string" } },
        "hypothesesToValidate": { "type": "array", "items": { "type": "string" } },
        "screenerQuestions": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
